# Maintainer: mstewart14 <46582721+mstewart14@users.noreply.github.com>
#
# NOTE: all deps below (python-pystray included) are now in the official
# `extra` repo, so plain `makepkg -si` resolves everything -- no AUR
# helper needed. Verified building/installing on Manjaro. If a package
# name has changed since, `pacman -Ss <topic>` will find the current one.
pkgname=immich-wallpaper
pkgver=1.0.8
pkgrel=1
pkgdesc="Rotate desktop wallpaper from a self-hosted Immich library, with a tray icon for status and controls"
arch=('any')
url="https://github.com/mstewart14/immich-wallpaper"
license=('MIT')
depends=('python' 'python-pillow' 'python-gobject' 'gtk3' 'libayatana-appindicator' 'python-pystray' 'xorg-xrandr' 'xorg-xprop')
optdepends=('kdialog: save-a-copy dialog on KDE Plasma'
            'zenity: save-a-copy dialog on GTK-based desktops (e.g. XFCE)')
source=("$pkgname-$pkgver.tar.gz::https://github.com/mstewart14/immich-wallpaper/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('2dac340057039d93911c04acdf37e375df2468a9903e13095b2f1aa2729fdf50')

package() {
  cd "$srcdir/$pkgname-$pkgver"

  # The web settings page (config_ui.py, index.html) is for platforms without
  # GTK and is deliberately not installed on Linux.
  install -Dm644 rotate.py tray_app.py settings_window.py settings_service.py \
    settings.py immich_api.py desktops.py layout.py screens.py compose.py -t "$pkgdir/usr/share/immich-wallpaper/"
  install -Dm644 assets/immich-flower.png assets/app-icon.png -t "$pkgdir/usr/share/immich-wallpaper/assets/"
  install -Dm644 assets/app-icon.png "$pkgdir/usr/share/icons/hicolor/256x256/apps/immich-wallpaper.png"
  install -Dm644 packaging/io.github.mstewart14.ImmichWallpaper.desktop -t "$pkgdir/usr/share/applications/"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"

  install -Dm755 /dev/stdin "$pkgdir/usr/bin/immich-wallpaper-tray" <<'EOF'
#!/bin/sh
exec python3 /usr/share/immich-wallpaper/tray_app.py "$@"
EOF

  install -Dm755 /dev/stdin "$pkgdir/usr/bin/immich-wallpaper-config" <<'EOF'
#!/bin/sh
exec python3 /usr/share/immich-wallpaper/settings_window.py "$@"
EOF

  install -Dm755 /dev/stdin "$pkgdir/usr/bin/immich-wallpaper-rotate" <<'EOF'
#!/bin/sh
exec python3 /usr/share/immich-wallpaper/rotate.py "$@"
EOF

  install -Dm644 /dev/stdin "$pkgdir/etc/xdg/autostart/immich-wallpaper-tray.desktop" <<'EOF'
[Desktop Entry]
Type=Application
Name=Immich Wallpaper Tray
Comment=Status icon and controls for the Immich wallpaper rotator
Exec=immich-wallpaper-tray
Icon=immich-wallpaper
Terminal=false
Categories=Utility;
X-GNOME-Autostart-enabled=true
EOF
}
